# Build-time settings for the static Astro site. Copy to .env for local development.
# In GitHub Actions these come from repository variables (Settings → Secrets and variables → Actions → Variables).

# Public URL of the API Worker.
PUBLIC_API_URL="http://localhost:8787"

# Public Turnstile site key. This is Cloudflare's documented "always passes" test key.
PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
